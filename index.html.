<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GNVS Friends SIP Calculator — FV, Goal & Top-up</title>
  <style>
    :root{--bg:#0f5f2a;--card:#0b3f1a;--muted:#cfe9d7;--accent:#34d399;--glass: rgba(255,255,255,0.03);--success:#10b981}
    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial;color:#e6eef6;background:linear-gradient(180deg,#0a3c1a 0%, #0f5f2a 100%);padding:20px}
    .container{max-width:1100px;margin:0 auto}
    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
    h1{font-size:20px;margin:0}
    .lead{margin:6px 0 0;color:var(--muted);font-size:13px}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    @media(max-width:1100px){.grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:700px){.grid{grid-template-columns:1fr}}
    .card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));padding:14px;border-radius:12px;box-shadow:0 6px 18px rgba(2,6,23,0.6);border:1px solid rgba(255,255,255,0.03)}
    label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px}
    input[type="number"], select{width:100%;padding:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:inherit;font-size:14px}
    input[type="range"]{width:100%}
    .row{display:flex;gap:10px}
    .row>div{flex:1}
    button{background:var(--accent);color:#022;border:none;padding:8px 10px;border-radius:8px;font-weight:600;cursor:pointer}
    .muted{color:var(--muted);font-size:13px}
    .result{margin-top:10px;background:var(--glass);padding:12px;border-radius:8px;border:1px solid rgba(255,255,255,0.02)}
    .big{font-size:18px;font-weight:700}
    .small{font-size:12px;color:var(--muted)}
    .controls{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
    .copy{background:transparent;border:1px solid rgba(255,255,255,0.06);padding:8px;border-radius:8px;color:var(--muted);cursor:pointer}
    footer{margin-top:16px;color:var(--muted);font-size:13px}
    .small-muted{font-size:12px;color:var(--muted)}
    .chart-wrap{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .chart-box{width:160px;height:160px}
  </style>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <div class="container">
    <header>
      <div>
        <h1>GNVS Friends SIP Calculator</h1>
        <div class="lead">SIP FV, Goal SIP and Annual Step-up — frequency, sliders and visual comparison.</div>
      </div>
      <div class="small-muted">Single-file HTML — optimized</div>
    </header>

    <div class="grid">

      <!-- SIP FV -->
      <section class="card" aria-labelledby="sipfv_title">
        <h3 id="sipfv_title">SIP Future Value (Periodic)</h3>
        <p class="small muted">Contribution per period, expected return and duration. Frequency: monthly / quarterly.</p>

        <label for="sip_amount">Contribution amount (per period)</label>
        <input id="sip_amount" type="number" min="0" value="10000" />

        <div class="row" style="margin-top:8px">
          <div>
            <label for="freq_fv">Frequency</label>
            <select id="freq_fv">
              <option value="12">Monthly</option>
              <option value="4">Quarterly</option>
            </select>
          </div>
          <div>
            <label for="annual_return">Expected annual return (%)</label>
            <input id="annual_return" type="number" step="0.01" value="12" />
          </div>
          <div>
            <label for="years">Duration (years)</label>
            <input id="years" type="number" min="0" value="10" />
          </div>
        </div>

        <div style="margin-top:8px">
          <label>Annual return: <span id="ann_lbl">12%</span></label>
          <input id="ann_slider" type="range" min="0" max="30" step="0.1" value="12">
        </div>
        <div style="margin-top:8px">
          <label>Years: <span id="yrs_lbl">10</span></label>
          <input id="yrs_slider" type="range" min="1" max="40" step="1" value="10">
        </div>

        

        <div id="fv_result" class="result" style="display:none" aria-live="polite">
          <div class="small muted">Your Investment</div>
          <div id="fv_invest" class="big">₹ 0</div>
          <hr style="border:0;border-top:1px solid rgba(255,255,255,0.05);margin:6px 0;">
          <div class="small muted">Future Value</div>
          <div id="fv_value" class="big">₹ 0</div>
          <div id="fv_details" class="small muted"></div>
          <div class="chart-wrap" style="margin-top:8px">
            <div class="chart-box"><canvas id="fv_pie"></canvas></div>
            <div class="small muted">Invested vs Future Value</div>
          </div>
        </div>
      </section>

      <!-- Goal SIP -->
      <section class="card" aria-labelledby="goalsip_title">
        <h3 id="goalsip_title">Goal-based Periodic Contribution required</h3>
        <label for="goal_amount">Goal Amount</label>
        <input id="goal_amount" type="number" min="0" value="2000000" />

        <div class="row" style="margin-top:8px">
          <div>
            <label for="freq_goal">Frequency</label>
            <select id="freq_goal">
              <option value="12">Monthly</option>
              <option value="4">Quarterly</option>
            </select>
          </div>
          <div>
            <label for="goal_return">Expected annual return (%)</label>
            <input id="goal_return" type="number" step="0.01" value="12" />
          </div>
          <div>
            <label for="goal_years">Years</label>
            <input id="goal_years" type="number" min="0" value="10" />
          </div>
        </div>

        <div style="margin-top:8px">
          <label>Annual return: <span id="ann_lbl_g">12%</span></label>
          <input id="ann_slider_g" type="range" min="0" max="30" step="0.1" value="12">
        </div>
        <div style="margin-top:8px">
          <label>Years: <span id="yrs_lbl_g">10</span></label>
          <input id="yrs_slider_g" type="range" min="1" max="40" step="1" value="10">
        </div>

        

        <div id="goal_result" class="result" style="display:none" aria-live="polite">
          <div class="small muted">Your Investment (approx)</div>
          <div id="goal_invest" class="big">₹ 0</div>
          <hr style="border:0;border-top:1px solid rgba(255,255,255,0.05);margin:6px 0;">
          <div class="small muted">Required Contribution per period (approx)</div>
          <div id="goal_value" class="big">₹ 0</div>
          <div id="goal_details" class="small muted"></div>
          <div class="chart-wrap" style="margin-top:8px">
            <div class="chart-box"><canvas id="goal_pie"></canvas></div>
            <div class="small muted">Invested vs Goal (contribution vs target)</div>
          </div>
        </div>
      </section>

      <!-- Step-up SIP -->
      <section class="card" aria-labelledby="step_title">
        <h3 id="step_title">Periodic Contribution with Annual Step-Up</h3>
        <label for="step_sip">Base Contribution (per period)</label>
        <input id="step_sip" type="number" min="0" value="10000" />

        <div class="row" style="margin-top:8px">
          <div>
            <label for="freq_step">Frequency</label>
            <select id="freq_step">
              <option value="12">Monthly</option>
              <option value="4">Quarterly</option>
            </select>
          </div>
          <div>
            <label for="step_up">Annual Step-up (%)</label>
            <input id="step_up" type="number" step="0.01" value="5" />
          </div>
          <div>
            <label for="step_return">Expected annual return (%)</label>
            <input id="step_return" type="number" step="0.01" value="12" />
          </div>
        </div>

        <div style="margin-top:8px">
          <label>Annual return: <span id="ann_lbl_s">12%</span></label>
          <input id="ann_slider_s" type="range" min="0" max="30" step="0.1" value="12">
        </div>
        <div style="margin-top:8px">
          <label>Years: <span id="yrs_lbl_s">10</span></label>
          <input id="yrs_slider_s" type="range" min="1" max="40" step="1" value="10">
        </div>

        <div style="margin-top:8px">
          <label for="step_years">Years</label>
          <input id="step_years" type="number" min="0" value="10" />
        </div>

        

        <div id="step_result" class="result" style="display:none" aria-live="polite">
          <div class="small muted">Your Investment (approx)</div>
          <div id="step_invest" class="big">₹ 0</div>
          <hr style="border:0;border-top:1px solid rgba(255,255,255,0.05);margin:6px 0;">
          <div class="small muted">Future Value with Step-up</div>
          <div id="step_value" class="big">₹ 0</div>
          <div id="step_details" class="small muted"></div>
          <div class="chart-wrap" style="margin-top:8px">
            <div class="chart-box"><canvas id="step_pie"></canvas></div>
            <div class="small muted">Invested vs Future Value</div>
          </div>
        </div>
      </section>

    </div>

    <footer style="margin-top:18px;display:flex;gap:12px;align-items:center;justify-content:space-between">
      <div class="small-muted">Want PDF export, WhatsApp share or Lakh/Crore formatting? I can add.</div>
      <div>
        <button id="export_html" class="copy">Download HTML file</button>
      </div>
    </footer>
  </div>

<script>
(function(){
  const $ = id => document.getElementById(id);
  const fmt = x => (isFinite(x) ? '₹ ' + Number(x).toLocaleString(undefined,{maximumFractionDigits:0, minimumFractionDigits:0}) : '—');
  function toNum(v){ const n = Number(String(v).replace(/,/g,'')); return isNaN(n)?NaN:n }

  // Periodic calculations
  function periodicFV(payment, annualRate, years, periodsPerYear){
    const r = Number(annualRate)/100/periodsPerYear;
    const n = Math.round(Number(years)*periodsPerYear);
    if(n<=0) return 0;
    if(r===0) return Number(payment)*n;
    return Number(payment)*((Math.pow(1+r,n)-1)/r)*(1+r);
  }
  function periodicRequired(paymentTarget, annualRate, years, periodsPerYear){
    const r = Number(annualRate)/100/periodsPerYear;
    const n = Math.round(Number(years)*periodsPerYear);
    if(n<=0) return 0;
    if(r===0) return paymentTarget/n;
    const factor = ((Math.pow(1+r,n)-1)/r)*(1+r);
    return paymentTarget / factor;
  }
  function stepUpFV(basePerPeriod, annualStepPct, annualRate, years, periodsPerYear){
    const r = Number(annualRate)/100/periodsPerYear;
    const periodsPerYearNum = Number(periodsPerYear);
    const totalPeriods = Math.round(Number(years)*periodsPerYearNum);
    let periodContribution = Number(basePerPeriod);
    let balance = 0;
    let count = 0;
    const periodsInYear = periodsPerYearNum;
    const stepFactor = 1 + Number(annualStepPct)/100;
    for(let y=0;y<Number(years);y++){
      for(let p=0;p<periodsInYear;p++){
        if(count >= totalPeriods) break;
        balance += periodContribution;
        balance *= (1 + r);
        count++;
      }
      periodContribution *= stepFactor;
    }
    return balance;
  }

  // Pie charts
  let fvChart, goalChart, stepChart;
  function createOrUpdatePie(chartRef, canvasId, invested, future){
    const data = [Number(invested||0), Math.max(0, Number(future||0)-Number(invested||0))];
    const labels = ['Invested','Growth'];
    const ctx = $(canvasId).getContext('2d');
    if(chartRef && chartRef.destroy) chartRef.destroy();
    chartRef = new Chart(ctx, {
      type: 'pie',
      data: { labels, datasets: [{ data, backgroundColor: ['#ffcc00','#0099ff'] }] },
      options: { plugins:{legend:{display:false}}, responsive:true, maintainAspectRatio:false }
    });
    return chartRef;
  }

  function show(id,flag){ const el=$(id); if(el) el.style.display = flag? 'block':'none' }

  function renderFV(){
    try{
      const payment = toNum($('sip_amount').value) || 0;
      const periodsPerYear = Number($('freq_fv').value) || 12;
      const ann = toNum($('annual_return').value) || 0;
      const yrs = toNum($('years').value) || 0;
      const totalPeriods = Math.round(yrs * periodsPerYear);
      const invested = payment * totalPeriods;
      const fv = periodicFV(payment, ann, yrs, periodsPerYear);
      $('fv_invest').textContent = fmt(invested);
      $('fv_value').textContent = fmt(fv);
      const freqLabel = periodsPerYear===12? 'Monthly' : 'Quarterly';
      $('fv_details').textContent = `${freqLabel} contribution ₹${Number(payment).toLocaleString()} × ${totalPeriods} periods @ ${ann}% p.a.`;
      show('fv_result', true);
      fvChart = createOrUpdatePie(fvChart, 'fv_pie', invested, fv);
    }catch(e){console.error(e); show('fv_result', true); $('fv_value').textContent='—'}
  }

  function renderGoal(){
    try{
      const target = toNum($('goal_amount').value) || 0;
      const periodsPerYear = Number($('freq_goal').value) || 12;
      const ann = toNum($('goal_return').value) || 0;
      const yrs = toNum($('goal_years').value) || 0;
      const contrib = periodicRequired(target, ann, yrs, periodsPerYear);
      const totalPeriods = Math.round(yrs * periodsPerYear);
      const invested = contrib * totalPeriods;
      $('goal_invest').textContent = fmt(invested);
      $('goal_value').textContent = fmt(contrib);
      const freqLabel = periodsPerYear===12? 'Monthly' : 'Quarterly';
      $('goal_details').textContent = `${freqLabel} contribution to reach ₹${Number(target).toLocaleString()} in ${yrs} years @ ${ann}% p.a.`;
      show('goal_result', true);
      goalChart = createOrUpdatePie(goalChart, 'goal_pie', invested, target);
    }catch(e){console.error(e); show('goal_result', true); $('goal_value').textContent='—'}
  }

  function renderStep(){
    try{
      const base = toNum($('step_sip').value) || 0;
      const periodsPerYear = Number($('freq_step').value) || 12;
      const step = toNum($('step_up').value) || 0;
      const ann = toNum($('step_return').value) || 0;
      const yrs = toNum($('step_years').value) || 0;
      const totalPeriods = Math.round(yrs * periodsPerYear);
      // Approx invested without applying step-up (display only)
      const invested = base * totalPeriods;
      const fv = stepUpFV(base, step, ann, yrs, periodsPerYear);
      $('step_invest').textContent = fmt(invested);
      $('step_value').textContent = fmt(fv);
      const freqLabel = periodsPerYear===12? 'Monthly' : 'Quarterly';
      $('step_details').textContent = `${freqLabel} base ₹${Number(base).toLocaleString()}, step-up ${step}% p.a., ${yrs} years @ ${ann}% p.a.`;
      show('step_result', true);
      stepChart = createOrUpdatePie(stepChart, 'step_pie', invested, fv);
    }catch(e){console.error(e); show('step_result', true); $('step_value').textContent='—'}
  }

  // bind events
  document.addEventListener('DOMContentLoaded', function(){
    // buttons (guarded — buttons removed but listeners added only if present)
    const bfv = $('calc_fv'); if(bfv) bfv.addEventListener('click', renderFV);
    const bgoal = $('calc_goal'); if(bgoal) bgoal.addEventListener('click', renderGoal);
    const bstep = $('calc_step'); if(bstep) bstep.addEventListener('click', renderStep);

    // sliders sync
    const syncSlider = (sliderId, inputId, labelId) => {
      const s = $(sliderId), inp = $(inputId), lbl = $(labelId);
      if(!s || !inp) return;
      s.addEventListener('input', ()=>{ inp.value = s.value; if(lbl) lbl.textContent = s.value + (labelId.includes('ann')? '%' : ''); renderFV(); renderGoal(); renderStep(); });
      inp.addEventListener('input', ()=>{ s.value = inp.value; if(lbl) lbl.textContent = inp.value + (labelId.includes('ann')? '%' : ''); renderFV(); renderGoal(); renderStep(); });
    }
    // main pairs
    syncSlider('ann_slider','annual_return','ann_lbl');
    syncSlider('yrs_slider','years','yrs_lbl');
    syncSlider('ann_slider_g','goal_return','ann_lbl_g');
    syncSlider('yrs_slider_g','goal_years','yrs_lbl_g');
    syncSlider('ann_slider_s','step_return','ann_lbl_s');
    syncSlider('yrs_slider_s','step_years','yrs_lbl_s');

    // export
    $('export_html').addEventListener('click', ()=>{ const html='<!doctype html>'+document.documentElement.outerHTML; const blob=new Blob([html],{type:'text/html'}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download='sip_calculator.html'; a.click(); URL.revokeObjectURL(url); });

    // live update on input
    ['sip_amount','annual_return','years','goal_amount','goal_return','goal_years','step_sip','step_up','step_return','step_years','freq_fv','freq_goal','freq_step'].forEach(id=>{ const el=$(id); if(!el) return; el.addEventListener('input', ()=>{ clearTimeout(el._t); el._t=setTimeout(()=>{ renderFV(); renderGoal(); renderStep(); }, 200) }) })

    // initial render
    renderFV(); renderGoal(); renderStep();
  });
})();
</script>
</body>
</html>
